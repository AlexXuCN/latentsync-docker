# LatentSync Docker 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# Gradio 服务配置
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=8080
GRADIO_SHARE=false

# GPU 配置
# 指定使用的 GPU（0, 1, 2 等，或 all）
CUDA_VISIBLE_DEVICES=0

# HuggingFace 配置
HF_HOME=/app/.cache/huggingface
# 如果需要访问私有模型，设置 token
# HF_TOKEN=your_huggingface_token_here

# 模型版本
# 可选: 1.5 (8GB VRAM) 或 1.6 (18GB VRAM)
MODEL_VERSION=1.6

# 端口映射
HOST_PORT=8082
CONTAINER_PORT=8080

# 性能配置
# PyTorch 线程数
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# 日志级别
LOG_LEVEL=INFO
