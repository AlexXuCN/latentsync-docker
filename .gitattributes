# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts
*.sh text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# Python
*.py text eol=lf

# Markdown
*.md text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Binary files
*.pt binary
*.pth binary
*.ckpt binary
*.safetensors binary
*.mp4 binary
*.avi binary
*.mov binary
*.wav binary
*.mp3 binary
*.png binary
*.jpg binary
*.jpeg binary
